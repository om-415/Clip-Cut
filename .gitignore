# Virtual Environment
.venv/
venv/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Video & Audio Media & Partial Downloads
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.part*
*.ytdl
*.wav
*.mp3
*.aac
*.m4a

# Temporary directories & downloads
downloads/**
!downloads/.gitkeep
processed/**
!processed/.gitkeep
clips/**
!clips/.gitkeep
subtitles/**
!subtitles/.gitkeep
temp/**
!temp/.gitkeep
logs/**
!logs/.gitkeep

# Models Cache (keep weights local, never push large model binaries)
models/**
!models/.gitkeep

# Database
*.db
*.sqlite3

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment Variables
.env
.env.local

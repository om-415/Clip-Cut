# FragFlash AI Stream Clipper - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Server
PORT=8000
HOST=127.0.0.1
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Paths (defaults to current project root)
BASE_DIR=.
MODELS_DIR=models
CLIPS_DIR=clips
DOWNLOADS_DIR=downloads
TEMP_DIR=temp

# AI Models & Cache
HF_HOME=models/cache/huggingface
TORCH_HOME=models/cache/torch
MPLCONFIGDIR=temp/matplotlib
DISABLE_SQLALCHEMY_CEXT=1

# Video Processing Tools (leave empty to use system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Video Export Defaults
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
DEFAULT_CLIP_DURATION=35
DEFAULT_SUBTITLE_STYLE=gaming_bold
DEFAULT_LAYOUT=split_stack

# YouTube Autonomous Publishing & Google Cloud OAuth 2.0 Credentials
# (Can also be configured via Settings UI)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth-callback

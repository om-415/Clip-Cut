# =============================================================================
# ClipCut Studio - Production Environment Configuration Template
# Copy this file to .env and fill in your genuine credentials before deploying.
# =============================================================================

# Server & Runtime Environment
APP_ENV=production
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://your-domain.com

# Database Connection (SQLite by default; supports PostgreSQL for scalable cluster deployment)
DATABASE_URL=sqlite:///stream_clipper.db

# Authentication Security (Generate a secure 64-char key using `openssl rand -hex 32`)
AUTH_SECRET_KEY=generate_a_secure_random_hex_key_here_for_jwt_session_signing

# CORS Whitelist (Comma-separated origins permitted to communicate with the API)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# Google Cloud Platform & YouTube Data API v3 Configuration
# -----------------------------------------------------------------------------
# 1. Create a project at https://console.cloud.google.com
# 2. Enable "YouTube Data API v3"
# 3. Configure OAuth Consent Screen (Scopes: openid, email, profile, youtube.upload, youtube.readonly)
# 4. Under Credentials, create an OAuth 2.0 Client ID (Web Application)
# 5. Add Authorized Redirect URIs:
#    - https://your-domain.com/auth/google/callback   (User Login / Registration)
#    - https://your-domain.com/oauth-callback          (YouTube Channel Connection)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# -----------------------------------------------------------------------------
# Sign in with Apple Configuration (Optional - Requires Apple Developer Account)
# -----------------------------------------------------------------------------
# 1. Register a Services ID at https://developer.apple.com/account/resources/identifiers
# 2. Create and download a private key (.p8) with Sign in with Apple enabled
# 3. Configure Return URL: https://your-domain.com/auth/apple/callback
APPLE_CLIENT_ID=ai.clipcut.web
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
# Paste the contents of your downloaded AuthKey_*.p8 key file
APPLE_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# AI Processing Engine & Storage Settings
# -----------------------------------------------------------------------------
# Whisper Model: tiny, base, small, medium (base recommended for CPU; small/medium for GPU)
WHISPER_MODEL=base

# Data Saver Mode: Only downloads top audio range segments to minimize disk and bandwidth consumption
DATA_SAVER_MODE=true

# Maximum stream video processing length in seconds (default: 14400 = 4 hours)
MAX_STREAM_DURATION=14400

# Cleanup Temporary Render Files after successful YouTube Upload (true / false)
AUTO_CLEANUP_TEMP=true
